# ============================================
# PassMaster — variables de entorno (Backend)
# Copia este archivo a .env y ajusta las credenciales
# de tu MySQL local antes de iniciar.
# ============================================

# Servidor API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL (ejemplo para XAMPP/MySQL local sin contraseña de root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=passmaster

# Seguridad (cambia JWT_SECRET en producción)
JWT_SECRET=papiandresdelaprogramacion
JWT_EXPIRES=8h
BCRYPT_ROUNDS=12
